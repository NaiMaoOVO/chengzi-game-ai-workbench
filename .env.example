# Public origin allowed by the API services. Comma-separate multiple origins and do not include trailing slashes.
ALLOWED_ORIGIN=https://example.com

# Optional. Keep the real cookie out of source control.
BILIBILI_COOKIE=

# Optional external read-only providers. HTTPS is required except for localhost.
# Expected response: {"items":[{"title":"...","author":"...","url":"...","views":1,"likes":1,"comments":1,"publishedAt":"..."}]}
DOUYIN_PROVIDER_URL=
DOUYIN_PROVIDER_TOKEN=
XIAOHONGSHU_PROVIDER_URL=
XIAOHONGSHU_PROVIDER_TOKEN=
PLATFORM_PROVIDER_TIMEOUT_MS=15000

# Optional local bridge for xiaohongshu-mcp / mcporter.
XHS_BRIDGE_PORT=8805
XHS_MCP_SERVER=xiaohongshu
# macOS global npm install example: /Users/chenzixun/.npm-global/bin/mcporter
MCPORTER_BIN=mcporter
XHS_BRIDGE_TOKEN=

HOTSPOT_PORT=8790
COMMENT_PORT=8791
OCR_PORT=8787

# LLM 增强服务（OpenAI 兼容接口，DeepSeek 默认；无 Key 时自动运行规则模式）
LLM_PORT=8794
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=45000
LLM_CACHE_TTL_MS=600000
LLM_RATE_LIMIT_MAX=20
LLM_MAX_CONCURRENCY=2

# Use macos with Swift on macOS, or remote on a Linux server.
OCR_PROVIDER=remote
OCR_REMOTE_URL=https://ocr-provider.example.com/v1/ocr
OCR_REMOTE_API_KEY=
OCR_TIMEOUT_MS=15000

# ── 本地存档服务（每日简报/分析快照持久化）──────────────
# 数据默认写入 ~/.gameops/archive.db，可用以下变量自定义：
# ARCHIVE_DB_PATH=/path/to/archive.db
# ARCHIVE_PORT=8796

OCR_READINESS_TIMEOUT_MS=90000
OCR_RATE_LIMIT_MAX=30
OCR_MAX_CONCURRENCY=2
OCR_ALLOW_INSECURE_REMOTE=false# 每日晨报自动抓取（存档服务内置定时器）：
# 每日晨报自动抓取（存档服务内置定时器）：
# MORNING_SCHEDULE=09:00
# MORNING_GAMES=鸣潮,原神
# MORNING_PLATFORM=B站

# MORNING_SCHEDULE=09:00
# MORNING_GAMES=鸣潮,原神
# MORNING_PLATFORM=B站


# Shared public API protections.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
CACHE_TTL_MS=60000
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_RETRIES=1
