limit_req_zone $binary_remote_addr zone=gameops_api:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=gameops_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    root /var/www/game-content-ops-ai-workbench/public;
    index index.html;

    client_max_body_size 12m;
    limit_req_status 429;
    limit_conn_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # Optional for a private interview demo:
    # auth_basic "GameOps Demo";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /api/hotspot { return 301 /api/hotspot/; }
    location /api/hotspot/ {
        limit_req zone=gameops_api burst=10 nodelay;
        limit_conn gameops_conn 10;
        proxy_pass http://127.0.0.1:8790/;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    location = /api/comment { return 301 /api/comment/; }
    location /api/comment/ {
        limit_req zone=gameops_api burst=10 nodelay;
        limit_conn gameops_conn 10;
        proxy_pass http://127.0.0.1:8791/;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }

    location = /api/ocr { return 301 /api/ocr/; }
    location /api/ocr/ {
        limit_req zone=gameops_api burst=5 nodelay;
        limit_conn gameops_conn 3;
        proxy_pass http://127.0.0.1:8787/;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 90s;
    }

    location = /api/llm { return 301 /api/llm/; }
    location /api/llm/ {
        limit_req zone=gameops_api burst=5 nodelay;
        limit_conn gameops_conn 3;
        proxy_pass http://127.0.0.1:8794/;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 120s;
    }

    location ~ /\. {
        deny all;
    }
}
